<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0D0D">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="28dp">
        <TextView android:text="TACADINHA PRO" android:textSize="24sp" android:textStyle="bold"
            android:textColor="#00FF88" android:gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Joga sozinho por voce!" android:textSize="12sp"
            android:textColor="#666666" android:gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"/>
        <TextView android:id="@+id/tvStatus" android:text="Verificando..."
            android:textSize="14sp" android:textColor="#AAAAAA" android:gravity="center"
            android:padding="14dp" android:background="#1A1A1A"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>
        <TextView android:text="Minhas bolas sao:" android:textSize="14sp"
            android:textColor="#AAAAAA" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>
        <RadioGroup android:id="@+id/rgMode" android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <RadioButton android:id="@+id/rbSolid" android:text="Cheias"
                android:textColor="#FFFFFF" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"/>
            <RadioButton android:id="@+id/rbStripe" android:text="Listradas"
                android:textColor="#FFFFFF" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"/>
            <RadioButton android:id="@+id/rbAuto" android:text="Auto" android:checked="true"
                android:textColor="#FFFFFF" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"/>
        </RadioGroup>
        <Button android:id="@+id/btnAccessibility" android:text="1. ATIVAR ACESSIBILIDADE"
            android:textSize="13sp" android:textColor="#000000"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginBottom="10dp" android:backgroundTint="#FFD700"/>
        <Button android:id="@+id/btnStart" android:text="2. INICIAR JOGO AUTO"
            android:textSize="13sp" android:textColor="#000000"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:layout_marginBottom="10dp" android:backgroundTint="#00FF88"/>
        <Button android:id="@+id/btnStop" android:text="PARAR"
            android:textSize="13sp" android:textColor="#FFFFFF"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:backgroundTint="#333333"/>
        <TextView android:text="\nComo usar:\n1. Toque ATIVAR ACESSIBILIDADE\n2. Ative Tacadinha Pro na lista\n3. Volte e selecione suas bolas\n4. Toque INICIAR JOGO AUTO\n5. Abra seu jogo de sinuca\n6. Toque TACAR para 1 tacada\n   ou ligue AUTO para jogar sozinho!"
            android:textSize="12sp" android:textColor="#555555"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:lineSpacingExtra="3dp"/>
    </LinearLayout>
</ScrollView>
